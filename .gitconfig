# This is Git's per-user configuration file.
[user]
	name = 
	email = 
[push]
	default = current
[core]
	editor = lvim
[alias]
	co = checkout
[mergetool]
	keepBackup = false
	hideResolved = true
[merge]
	tool = nvimdiff2
	conflictstyle = diff3
[pull]
	rebase = true
[init]
	defaultBranch = main
[difftool]
    prompt = true
[difftool "nvimdiff2"]
    cmd = "nvim -d \"$LOCAL\" \"$REMOTE\""
		hideResolved = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
